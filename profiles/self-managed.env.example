# <env>.env - self-managed cluster
# ================================
#
# One file per environment: copy to ~/.config/camunda/<env>.env and
# restrict it: chmod 600 ~/.config/camunda/*.env
#
# Settings here override common.env, so this file also works alongside a
# SaaS-oriented common.env.
#
# Record the client's name and permissions here: it's the first thing
# you'll want to know when a call returns 403.
#
#   Client:          <client name in the identity provider>
#   Authorizations:  PROCESS_DEFINITION: CANCEL_PROCESS_INSTANCE
#                                        DELETE_PROCESS_INSTANCE
#                                        READ_PROCESS_DEFINITION
#                                        READ_PROCESS_INSTANCE
#                                        UPDATE_PROCESS_INSTANCE

CAMUNDA_CLIENT_MODE='self-managed'

# The cluster's REST address (without /v2).
CAMUNDA_REST_ADDRESS='https://camunda.example.internal'

# --- Pick one authentication strategy -----------------------------------

# OAuth client credentials (Keycloak, Microsoft Entra ID, other OIDC).
CAMUNDA_AUTH_STRATEGY='oauth'
CAMUNDA_OAUTH_URL='https://keycloak.example.internal/auth/realms/camunda-platform/protocol/openid-connect/token'
CAMUNDA_TOKEN_AUDIENCE='orchestration-api'
#CAMUNDA_TOKEN_SCOPE='<scope>'        # e.g. Entra: api://<app-id>/.default
CAMUNDA_CLIENT_ID='<client-id>'
CAMUNDA_CLIENT_SECRET='<client-secret>'

# Basic authentication.
#CAMUNDA_AUTH_STRATEGY='basic'
#CAMUNDA_BASIC_AUTH_USERNAME='<username>'
#CAMUNDA_BASIC_AUTH_PASSWORD='<password>'

# No authentication (local development clusters only).
#CAMUNDA_AUTH_STRATEGY='none'

# Scripts ask for confirmation before changing anything. Set this to
# 'false' to stop them asking in this environment.
#CAMUNDA_PROTECTED='false'
