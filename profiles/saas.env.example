# <env>.env - Camunda SaaS cluster
# ================================
#
# One file per environment: copy to ~/.config/camunda/dev.env (sit.env,
# uat.env, prod.env, ...) and restrict it: chmod 600 ~/.config/camunda/*.env
#
# Record the client's name, scopes and permissions here: it's the first
# thing you'll want to know when a call returns 403.
#
#   Client:          <client name in Console>
#   Scopes:          Orchestration
#   Authorizations:  PROCESS_DEFINITION: CANCEL_PROCESS_INSTANCE
#                                        DELETE_PROCESS_INSTANCE
#                                        READ_PROCESS_DEFINITION
#                                        READ_PROCESS_INSTANCE
#                                        UPDATE_PROCESS_INSTANCE

CAMUNDA_CLUSTER_ID='<cluster-id>'
CAMUNDA_CLIENT_ID='<client-id>'
CAMUNDA_CLIENT_SECRET='<client-secret>'

# Only if this cluster is in a different region to the one in common.env:
#CAMUNDA_CLUSTER_REGION='fra-1'

# Scripts ask for confirmation before changing anything. Set this to
# 'false' to stop them asking in this environment.
#CAMUNDA_PROTECTED='false'
