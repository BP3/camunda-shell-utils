# common.env
# ==========
#
# Values shared by every customer. Copy to ~/.config/camunda/common.env.
# Anything here can be overridden in a customer's own common.env, or in an
# environment's file. Settings that differ between customers, such as the
# SaaS region or SaaS vs self-managed, belong in the customer's common.env
# (see customer-common.env.example).
#
# The values below are also the built-in defaults for SaaS, so this file
# is optional; it's here to make them visible.

CAMUNDA_OAUTH_URL='https://login.cloud.camunda.io/oauth/token'
CAMUNDA_TOKEN_AUDIENCE='zeebe.camunda.io'
