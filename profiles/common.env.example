# common.env
# ==========
#
# Values shared by every environment. Copy to ~/.config/camunda/common.env.
# Anything here can be overridden in an environment's own file.
#
# For SaaS, the token URL and audience below are also the built-in defaults,
# so this file is optional; it's here to make them visible.

CAMUNDA_CLIENT_MODE='saas'
CAMUNDA_CLUSTER_REGION='fra-1'

CAMUNDA_OAUTH_URL='https://login.cloud.camunda.io/oauth/token'
CAMUNDA_TOKEN_AUDIENCE='zeebe.camunda.io'
