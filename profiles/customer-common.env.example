# <customer>/common.env
# =====================
#
# Values shared by all of one customer's environments. Copy to
# ~/.config/camunda/<customer>/common.env. Anything here overrides the
# shared ~/.config/camunda/common.env, and can itself be overridden in one
# of the customer's environment files.

# SaaS (the default) or self-managed, if all this customer's clusters are
# the same. For self-managed, see self-managed.env.example for the rest.
CAMUNDA_CLIENT_MODE='saas'

# The SaaS region the customer's clusters are in. Set it in an environment's
# file instead if a cluster is somewhere else.
CAMUNDA_CLUSTER_REGION='fra-1'
