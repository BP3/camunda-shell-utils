# c8-profile - the old name for 'c8sh profile'
#
# Kept for now so that existing scripts keep working; it will be removed.

set -eu

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
bin=$(cd "$(dirname "$self")" && pwd)

# Quiet for 'prompt': it runs every time the shell draws a prompt.
[ "${1:-}" = prompt ] ||
    printf "%s: renamed to 'c8sh profile'; this name will be removed\n" "${0##*/}" >&2
# shellcheck disable=SC2086 # C8SH_SHELL may be "bash --posix"
exec ${C8SH_SHELL:-/bin/sh} "$bin/c8sh" profile "$@"
