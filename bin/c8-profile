#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 BP3 Global Inc.
#
# c8-profile - show, list and switch customer and environment profiles
#
#   c8-profile                  what's in effect, and where it came from
#   c8-profile list             every customer/environment
#   c8-profile use acme dev     save a default (also: acme/dev)
#   c8-profile clear            forget the saved default
#   c8-profile prompt           "acme/dev", for a shell prompt

set -eu

# Find lib/ next to bin/, following symlinks (e.g. from ~/bin).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
. "$(cd "$(dirname "$self")/.." && pwd)/lib/camunda.sh"

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION]... [COMMAND [ARGS]]

Show, list and switch customer and environment profiles.

Commands:
  show                    the customer and environment in effect, where each
                          choice came from, and the settings they give
                          (the default command)
  list                    every customer/environment, marking the one in
                          effect with '*'
  use CUSTOMER [ENV]      save CUSTOMER and ENV as the default, for every
                          terminal (also: use CUSTOMER/ENV); without ENV,
                          only the customer is saved
  clear                   forget the saved default
  prompt                  print "customer/env" (or nothing), for a shell prompt

The customer and environment come from, in order: the -c and -e options;
CAMUNDA_CUSTOMER and CAMUNDA_ENV in the shell; the saved default. A saved
environment is only used with the saved customer.

Options:
  -c, --customer NAME         show as if this customer were chosen
  -e, --environment-name ENV  show as if this environment were chosen
  -h, --help                  show this help and exit
EOF
}

while [ $# -gt 0 ]; do
    case $1 in
        --) shift; break ;;
        -?*) camunda_common_option "$@"; shift "$_camunda_shift" ;;
        *) break ;;
    esac
done
command=${1:-show}
[ $# -eq 0 ] || shift

# What this shell itself sets, before any saved default is filled in.
shell_customer=${CAMUNDA_CUSTOMER:-}
shell_env=${CAMUNDA_ENV:-}

# Paths with ~ for home, to keep lines short.
# shellcheck disable=SC2088 # the ~ is printed, not expanded
tilde() {
    case $1 in
        "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

show() {
    [ $# -eq 0 ] || camunda_usage_error "'show' takes no arguments"
    camunda_select_profile
    printf '%-12s %-24s (%s)\n' customer "${CAMUNDA_CUSTOMER:-none}" "$CAMUNDA_CUSTOMER_FROM"
    printf '%-12s %-24s (%s)\n' environment "${CAMUNDA_ENV:-none}" "$CAMUNDA_ENV_FROM"
    if [ -z "$CAMUNDA_ENV" ]; then
        if [ -n "$CAMUNDA_CUSTOMER" ] && [ ! -d "$_camunda_profile_dir" ]; then
            printf '%-12s %s\n' problem "no folder $(tilde "$_camunda_profile_dir")"
        elif [ -n "$CAMUNDA_CUSTOMER" ] || [ -z "$(camunda_list_customers)" ]; then
            printf '%-12s %s\n' choose "an environment: $(camunda_list_envs | paste -s -d ' ' -)"
        else
            printf '%-12s %s\n' choose "a customer: $(camunda_list_customers | paste -s -d ' ' -)"
            envs=$(camunda_list_envs | paste -s -d ' ' -)
            if [ -n "$envs" ]; then
                printf '%-12s %s\n' '' "or an environment without one: $envs"
            fi
        fi
        return 0
    fi

    # Load it in a subshell: a broken profile is reported, not fatal.
    (
        camunda_load_profile
        heading=profiles
        for f in "$_camunda_config_dir/common.env" \
            ${CAMUNDA_CUSTOMER:+"$_camunda_profile_dir/common.env"} "$_camunda_profile_dir/$CAMUNDA_ENV.env"; do
            [ -f "$f" ] || continue
            printf '%-12s %s\n' "$heading" "$(tilde "$f")"
            heading=
        done
        printf '%-12s %s\n' mode "$CAMUNDA_CLIENT_MODE"
        printf '%-12s %s\n' address "$CAMUNDA_REST_ADDRESS"
        case $CAMUNDA_AUTH_STRATEGY in
            oauth)
                printf '%-12s oauth, client %s, secret %s\n' auth "$CAMUNDA_CLIENT_ID" \
                    "$([ -n "${CAMUNDA_CLIENT_SECRET:-}" ] && echo set || echo missing)"
                token=none
                if [ -f "$_camunda_token_file" ]; then
                    exp=$(head -n 1 "$_camunda_token_file")
                    left=$((exp - $(date +%s)))
                    if [ "$left" -gt 0 ]; then
                        token="cached, valid for $((left / 60)) more minute(s)"
                    else
                        token="cached, expired"
                    fi
                fi
                printf '%-12s %s\n' token "$token"
                ;;
            basic) printf '%-12s basic, user %s\n' auth "$CAMUNDA_BASIC_AUTH_USERNAME" ;;
            none) printf '%-12s none\n' auth ;;
        esac
        if camunda_is_protected; then
            printf '%-12s %s\n' confirm "yes: changes need you to type '$CAMUNDA_LABEL'"
        else
            printf '%-12s %s\n' confirm "no (CAMUNDA_PROTECTED is false)"
        fi
    ) || printf '%-12s %s\n' problem "the profile above can't be used (see the error)"
}

list() {
    [ $# -eq 0 ] || camunda_usage_error "'list' takes no arguments"
    camunda_select_profile
    current=$CAMUNDA_LABEL
    {
        camunda_list_envs ''
        for customer in $(camunda_list_customers); do
            camunda_list_envs "$customer" | sed "s|^|$customer/|"
        done
    } | while IFS= read -r label; do
        if [ "$label" = "$current" ]; then
            printf '* %s\n' "$label"
        else
            printf '  %s\n' "$label"
        fi
    done
}

use() {
    case $# in
        1)
            case $1 in
                */*) customer=${1%%/*} env=${1#*/} ;;
                *) customer=$1 env= ;;
            esac
            ;;
        2) customer=$1 env=$2 ;;
        *) camunda_usage_error "usage: ${0##*/} use CUSTOMER [ENV]" ;;
    esac
    camunda_select_profile
    [ -n "$customer" ] || camunda_usage_error "usage: ${0##*/} use CUSTOMER [ENV]"
    _camunda_check_name customer "$customer"
    if [ ! -d "$_camunda_config_dir/$customer" ]; then
        # Without customer folders, 'use dev' can mean an environment.
        if [ -z "$env" ] && [ -f "$_camunda_config_dir/$customer.env" ]; then
            env=$customer
            customer=
        else
            camunda_die "no customer '$customer' in $(tilde "$_camunda_config_dir")" \
                "(customers: $(camunda_list_customers | paste -s -d ' ' -))"
        fi
    fi
    if [ -n "$env" ]; then
        _camunda_check_name environment "$env"
        [ -f "$_camunda_config_dir${customer:+/$customer}/$env.env" ] ||
            camunda_die "no environment '$env' for ${customer:-the folder}" \
                "(environments: $(camunda_list_envs "$customer" | paste -s -d ' ' -))"
    fi

    umask 077
    printf '# written by c8-profile use\ncustomer=%s\nenv=%s\n' "$customer" "$env" \
        >"$_camunda_state_file.$$"
    mv -f "$_camunda_state_file.$$" "$_camunda_state_file"

    label=${customer:+$customer/}$env
    if [ -z "$env" ]; then
        printf 'saved default: customer %s, no environment (choose from: %s)\n' "$customer" \
            "$(camunda_list_envs "$customer" | paste -s -d ' ' -)"
    else
        printf 'saved default: %s\n' "$label"
    fi
    # Say if this shell overrides what was just saved.
    if [ -n "$shell_customer" ] && [ "$shell_customer" != "$customer" ]; then
        camunda_warn "CAMUNDA_CUSTOMER=$shell_customer in this shell overrides it here" \
            "(unset CAMUNDA_CUSTOMER to use the default)"
    fi
    if [ -n "$shell_env" ] && [ "$shell_env" != "$env" ]; then
        camunda_warn "CAMUNDA_ENV=$shell_env in this shell overrides it here" \
            "(unset CAMUNDA_ENV to use the default)"
    fi
}

clear_default() {
    [ $# -eq 0 ] || camunda_usage_error "'clear' takes no arguments"
    camunda_select_profile
    rm -f "$_camunda_state_file"
    echo "saved default cleared"
}

# Quick and quiet: runs at every shell prompt.
prompt() {
    (camunda_select_profile) >/dev/null 2>&1 || exit 0
    camunda_select_profile
    if [ -n "$CAMUNDA_CUSTOMER" ]; then
        printf '%s/%s\n' "$CAMUNDA_CUSTOMER" "${CAMUNDA_ENV:--}"
    elif [ -n "$CAMUNDA_ENV" ]; then
        printf '%s\n' "$CAMUNDA_ENV"
    fi
}

case $command in
    show) show "$@" ;;
    list) list "$@" ;;
    use) use "$@" ;;
    clear) clear_default "$@" ;;
    prompt) prompt "$@" ;;
    *) camunda_usage_error "unknown command '$command'" ;;
esac
