#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 BP3 Global Inc.
#
# c8-delete-process-instances - delete the finished instances of process versions
#
# Deletes the history of COMPLETED and TERMINATED instances; the versions
# themselves stay deployed. Takes "processDefinitionId version" pairs, on
# the command line or piped in from c8-list-process-versions, and starts one
# deletion batch operation per version that has finished instances:
#
#   c8-list-process-versions Process_X | c8-delete-process-instances --dry-run

set -eu

# Find lib/ next to bin/, following symlinks (e.g. from ~/bin).
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
. "$(cd "$(dirname "$self")/.." && pwd)/lib/camunda.sh"

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION]... [PROCESS_ID VERSIONS...]

Delete the finished (completed or terminated) instances of the given process
versions: their history is removed, and the versions stay deployed. Active
instances are never touched; cancel them first with
c8-cancel-process-instances if you need to.

VERSIONS picks from the process's deployed versions. Combine any of:

  670 671                     exact versions
  27-100, 27 to 100           an inclusive range
  first-600, 600-last         from the oldest, or to the newest, deployed
                              version (600- also works)
  older than 50, before 50    versions below 50; also '<50', '<=50'
  newer than 50, after 50     versions above 50; also '>50', '>=50'
  oldest 10                   the 10 oldest deployed versions
  newest 5, latest 5          the 5 newest; 'latest' alone means 1
  all                         every deployed version
  ... except ..., ... but ... leave out what follows

For example: 'all but newest 5', 'older than 600 except 400-410'. Quote
anything with < or > so the shell doesn't treat it as a redirection. The
versions selected are listed on stderr.

With no arguments, read "processDefinitionId version" pairs from stdin, one
per line, using the last two fields of each line, so the output of
c8-list-process-versions can be piped in:

  c8-list-process-versions PROCESS_ID | ${0##*/} --dry-run

Output, one line per item, for piping into other commands:

  --dry-run   processDefinitionId version processInstanceKey
              (each instance that would be deleted)
  otherwise   processDefinitionId version batchOperationKey
              (each deletion started; it runs in the background)

A summary goes to stderr. Instances called from other processes are
deleted too, and counted separately in the summary. Exits with status 1 if
any requested version isn't deployed.

Options:
  -n, --dry-run               show what would be deleted; change nothing
  -y, --yes                   don't ask for confirmation in protected
                              environments (e.g. prod)
  -e, --environment-name ENV  environment profile to use (default: \$CAMUNDA_ENV)
  -h, --help                  show this help and exit
EOF
}

dry_run=
while [ $# -gt 0 ]; do
    case $1 in
        -n | --dry-run) dry_run=1; shift ;;
        -y | --yes) CAMUNDA_ASSUME_YES=1; shift ;;
        --) shift; break ;;
        -?*) camunda_common_option "$@"; shift "$_camunda_shift" ;;
        *) break ;;
    esac
done

camunda_check_version_args "$@"
camunda_load_profile
tmp=$CAMUNDA_TMPDIR
status=0

camunda_resolve_versions "$@" || status=$?
[ -s "$CAMUNDA_TARGETS" ] || exit "$status"

# Only finished instances can be deleted. Say so in every request rather
# than rely on the server to skip active ones.
finished='{"state": {"$in": ["COMPLETED", "TERMINATED"]}}'
camunda_find_instances "$finished" "$tmp/finished"
camunda_count_instances "$tmp/finished" >"$tmp/counts"

total=$(wc -l <"$tmp/finished" | tr -d ' ')
versions=$(awk '$4 > 0' "$tmp/counts" | wc -l | tr -d ' ')
detail=$(jq -s -r '
    "\(map(select(.state == "COMPLETED")) | length) completed, " +
    "\(map(select(.state == "TERMINATED")) | length) terminated; " +
    "\(map(select(.parentProcessInstanceKey != null)) | length) called from other processes"
' "$tmp/finished")

if [ -n "$dry_run" ]; then
    camunda_list_instances "$tmp/finished"
    printf '%s: dry run in %s: would delete %s instance(s) of %s version(s) (%s); nothing changed\n' \
        "${0##*/}" "$CAMUNDA_ENV" "$total" "$versions" "$detail" >&2
    exit "$status"
fi

if [ "$total" -eq 0 ]; then
    printf '%s: no finished instances to delete in %s\n' "${0##*/}" "$CAMUNDA_ENV" >&2
    exit "$status"
fi

camunda_confirm "delete $total finished instance(s) of $versions process version(s)"
camunda_run_batches /process-instances/deletion "$finished" <"$tmp/counts" || status=1
printf '%s: started deleting %s instance(s) in %s\n' "${0##*/}" "$CAMUNDA_BATCHED" "$CAMUNDA_ENV" >&2
exit "$status"
